# Copy to backend/.env and adjust. All variables are optional.
# Secrets (e.g. a future provider API key) belong here, never in the frontend.

# JSON list of allowed browser origins for CORS
PARKFINDER_CORS_ORIGINS=["http://localhost:5173"]

# Contact e-mail sent in the User-Agent, as requested by the Nominatim usage policy
PARKFINDER_CONTACT_EMAIL=

# Upstream endpoints (swap to a self-hosted instance if needed)
PARKFINDER_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
PARKFINDER_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Timeouts (seconds) and retries for upstream calls
PARKFINDER_CONNECT_TIMEOUT=5
PARKFINDER_READ_TIMEOUT=25
PARKFINDER_MAX_RETRIES=2

# In-memory cache
PARKFINDER_CACHE_TTL_SECONDS=300
PARKFINDER_CACHE_MAX_ENTRIES=256

# Public endpoint protection
PARKFINDER_RATE_LIMIT_PER_MINUTE=60
PARKFINDER_MAX_BBOX_SPAN_DEG=1.0

# Serve assets/parks.sample.json when OpenStreetMap is unavailable
PARKFINDER_ENABLE_SAMPLE_FALLBACK=true

# Traceability logs (JSON lines, rotated). Default location: backend/logs/api.log
PARKFINDER_LOG_LEVEL=INFO
PARKFINDER_LOG_TO_FILE=true
# PARKFINDER_LOG_DIR=C:/path/to/logs
PARKFINDER_LOG_MAX_BYTES=5000000
PARKFINDER_LOG_BACKUP_COUNT=5
